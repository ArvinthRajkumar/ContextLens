<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only: the API, Firebase and Cloud Storage are all TLS. No
     cleartext, no user-added CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
