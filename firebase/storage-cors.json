[
  {
    "origin": ["*"],
    "method": ["GET", "PUT", "POST", "DELETE", "OPTIONS"],
    "responseHeader": [
      "Content-Type",
      "Content-Range",
      "Range",
      "Location",
      "x-goog-resumable",
      "X-Upload-Content-Length",
      "X-Upload-Content-Type"
    ],
    "maxAgeSeconds": 3600
  }
]
